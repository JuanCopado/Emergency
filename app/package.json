{
  "name": "emergency",
  "version": "0.1.0",
  "description": "Emergency — clinical reference PWA for emergency/ICU infusions (Sprint 1, draft)",
  "scripts": {
    "dev": "vite",
    "build": "npm run corticosteroids:check && npm run guides:build && npm run procedures:build && npm run pediatrics:build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "guides:build": "node scripts/build-clinical-guides.mjs",
    "guides:test": "node --test scripts/build-clinical-guides.node-test.mjs",
    "guides:print-check": "node scripts/check-clinical-guide-print.mjs",
    "procedures:build": "node scripts/build-procedures.mjs",
    "procedures:test": "node --test scripts/build-procedures.node-test.mjs",
    "pediatrics:build": "python ../clinical/scripts/build_pediatric_catalog.py",
    "pediatrics:check": "python ../clinical/scripts/build_pediatric_catalog.py --check",
    "pediatrics:browser-check": "node scripts/check-pediatric-outpatient.mjs",
    "insulin:browser-check": "node scripts/check-insulin-uci.mjs",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "postinstall": "node scripts/picomatch-mitigation.mjs --apply",
    "security:picomatch:apply": "node scripts/picomatch-mitigation.mjs --apply",
    "security:picomatch:check": "node scripts/picomatch-mitigation.mjs --check",
    "security:picomatch:revert": "node scripts/picomatch-mitigation.mjs --revert",
    "security:picomatch:test": "node --test scripts/picomatch-mitigation.node-test.mjs",
    "predev": "node scripts/picomatch-mitigation.mjs --check",
    "prebuild": "node scripts/picomatch-mitigation.mjs --check",
    "pretest": "node scripts/picomatch-mitigation.mjs --check",
    "prelint": "node scripts/picomatch-mitigation.mjs --check",
    "pretypecheck": "node scripts/picomatch-mitigation.mjs --check",
    "prepreview": "node scripts/picomatch-mitigation.mjs --check",
    "pretest:coverage": "node scripts/picomatch-mitigation.mjs --check",
    "preicons": "node scripts/picomatch-mitigation.mjs --check",
    "prescreenshots": "node scripts/picomatch-mitigation.mjs --check",
    "preguides:build": "node scripts/picomatch-mitigation.mjs --check",
    "preguides:test": "node scripts/picomatch-mitigation.mjs --check",
    "preguides:print-check": "node scripts/picomatch-mitigation.mjs --check",
    "preprocedures:build": "node scripts/picomatch-mitigation.mjs --check",
    "preprocedures:test": "node scripts/picomatch-mitigation.mjs --check",
    "prepediatrics:build": "node scripts/picomatch-mitigation.mjs --check",
    "prepediatrics:check": "node scripts/picomatch-mitigation.mjs --check",
    "prepediatrics:browser-check": "node scripts/picomatch-mitigation.mjs --check",
    "preinsulin:browser-check": "node scripts/picomatch-mitigation.mjs --check",
    "security:picomatch:installation-check": "node scripts/check-picomatch-installation.mjs",
    "i18n:browser-check": "node scripts/check-locale-safety.mjs",
    "prei18n:browser-check": "node scripts/picomatch-mitigation.mjs --check",
    "pwa:offline-check": "node scripts/check-pwa-offline.mjs",
    "r51:flag-check": "node scripts/check-r51-flag-production.mjs",
    "prer51:flag-check": "node scripts/picomatch-mitigation.mjs --check",
    "hf:lab-preflight": "node scripts/hf-lab-preflight.mjs",
    "prehf:lab-preflight": "node scripts/picomatch-mitigation.mjs --check",
    "prepwa:offline-check": "node scripts/picomatch-mitigation.mjs --check",
    "build:security": "npm run build && node scripts/build-dependency-guard.mjs --check-service-worker",
    "prebuild:security": "node scripts/picomatch-mitigation.mjs --check",
    "precheck:lab-exclusion": "node scripts/picomatch-mitigation.mjs --check",
    "check:lab-exclusion": "node scripts/check-lab-exclusion.mjs dist",
    "corticosteroids:check": "python ../clinical/scripts/build_corticosteroid_catalog.py --check",
    "therapy:browser-check": "node scripts/check-therapeutic-review.mjs",
    "pretherapy:browser-check": "node scripts/picomatch-mitigation.mjs --check",
    "precorticosteroids:check": "node scripts/picomatch-mitigation.mjs --check"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "i18next": "^26.4.2",
    "pdfjs-dist": "6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "7.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.12"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "source-map-js": "1.2.2",
    "undici": "8.12.2",
    "fast-uri": "3.1.9",
    "postcss-selector-parser": "6.1.5",
    "serialize-javascript": "7.1.3",
    "workbox-build": {
      "glob": "14.0.2"
    },
    "glob": {
      "minimatch": "11.0.9"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.9"
    }
  }
}
