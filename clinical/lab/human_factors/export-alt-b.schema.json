{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "emergency:human-factors-export:alt-b-0.1",
 "title": "Human-factors Stage 1 · Alternative B export (laboratory; NOT an executed study; synthetic technical-driver data only)",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema_version", "study_stage", "layer7_execution_mode", "layer7_result_label", "study_status", "tooling_status", "data_origin",
              "unimplemented_stage2_models", "acceptance_decision", "tool_version", "git_commit_sha", "resamples", "seed",
              "stimuli_manifest_sha256", "stimuli_bytes_sha256", "records_sha256", "summary_sha256", "mechanism_partition", "summary", "limitations"],
 "properties": {
  "schema_version": {"const": "alt-b-0.1"},
  "study_stage": {"const": "STAGE_1_FORMATIVE_ALT_B"},
  "layer7_execution_mode": {"const": "SIMULATED_LAB_HARNESS_ONLY"},
  "layer7_result_label": {"const": "SIMULATED_LAYER7_HARNESS_LAB_ONLY"},
  "study_status": {"const": "NOT_EXECUTED_PROTOCOL_ONLY"},
  "tooling_status": {"const": "NOT_EXECUTED_TOOLING_ONLY"},
  "data_origin": {"const": "SYNTHETIC_TECHNICAL_DRIVER"},
  "unimplemented_stage2_models": {"const": ["GLMM", "GEE_SMALL_SAMPLE", "DEVICE_ARM_INTERACTION"]},
  "acceptance_decision": {"const": "PENDING_PHYSICIAN_OWNER_REVIEW"},
  "tool_version": {"type": "string", "pattern": "^hf-tools-[0-9]+\\.[0-9]+$"},
  "git_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
  "resamples": {"type": "integer", "minimum": 1},
  "seed": {"type": "string"},
  "stimuli_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "stimuli_bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "mechanism_partition": {"type": "object", "additionalProperties": false, "required": ["M1", "M2", "M3"],
                          "properties": {"M1": {"type": "integer", "minimum": 0}, "M2": {"type": "integer", "minimum": 0}, "M3": {"type": "integer", "minimum": 0}}},
  "summary": {"type": "object", "additionalProperties": false, "required": ["mechanism_partition", "excluded_from_between_arm_contrasts", "m1", "m2", "m3"],
              "properties": {"mechanism_partition": {"type": "object"}, "excluded_from_between_arm_contrasts": {"const": ["M2"]},
                             "m1": {"type": "object"}, "m3": {"type": "object"},
                             "m2": {"type": "object", "required": ["mechanism", "between_arm_contrast"],
                                    "properties": {"mechanism": {"const": "M2"}, "between_arm_contrast": {"const": "PROHIBITED_NOT_COMPUTED"}}}}},
  "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1}
 }
}
